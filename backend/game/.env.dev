DATABASE_URL="postgresql://postgres:postgres@localhost:5438/game_db?schema=public"
# must be the same secret as the auth service: the game only verifies its tokens
JWT_SECRET="dev-jwt-secret"
PORT=3003
# ranking service that receives the finished runs (leave empty to not send them)
RANKING_API_URL="http://localhost:3002"
# shared with the store backend
INTERNAL_API_KEY="dev-internal-key"
# store service that owns the characters (leave empty to let any character play)
STORE_API_URL="http://localhost:3001"
