generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  IN_PROGRESS
  WON
  DIED
}

model Weapon {
  id       String @id
  name     String
  maxLevel Int    @map("max_level")

  characters Character[]
  runWeapons RunWeapon[]

  @@map("weapons")
}

model PassiveItem {
  id       String @id
  name     String
  maxLevel Int    @map("max_level")

  runPassiveItems RunPassiveItem[]

  @@map("passive_items")
}

model Character {
  id            String @id
  name          String
  startWeaponId String @map("start_weapon_id")

  startWeapon Weapon @relation(fields: [startWeaponId], references: [id])
  runs        Run[]

  @@map("characters")
}

model Run {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  characterId  String    @map("character_id")
  status       RunStatus @default(IN_PROGRESS)
  score        Int       @default(0)
  kills        Int       @default(0)
  levelReached Int       @default(1) @map("level_reached")
  survivedTime Int       @default(0) @map("survived_time")
  coinsEarned  Int       @default(0) @map("coins_earned")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  character    Character        @relation(fields: [characterId], references: [id])
  weapons      RunWeapon[]
  passiveItems RunPassiveItem[]

  @@index([userId])
  @@map("runs")
}

model RunWeapon {
  id       String @id @default(uuid())
  runId    String @map("run_id")
  weaponId String @map("weapon_id")
  level    Int

  run    Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  weapon Weapon @relation(fields: [weaponId], references: [id])

  @@unique([runId, weaponId])
  @@map("run_weapons")
}

model RunPassiveItem {
  id            String @id @default(uuid())
  runId         String @map("run_id")
  passiveItemId String @map("passive_item_id")
  level         Int

  run         Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  passiveItem PassiveItem @relation(fields: [passiveItemId], references: [id])

  @@unique([runId, passiveItemId])
  @@map("run_passive_items")
}

model Enemy {
  id        String @id
  name      String
  icon      String
  color     String
  hp        Int
  speed     Int
  damage    Int
  radius    Int
  xp        Int
  score     Int
  minTime   Int    @default(0) @map("min_time")
  weight    Int    @default(0) @map("spawn_weight")
  splits    Int    @default(0)
  bossOrder Int?   @unique @map("boss_order")

  @@map("enemies")
}

model Pickup {
  id         String @id
  name       String
  value      Int
  dropChance Float  @map("drop_chance")

  @@map("pickups")
}
