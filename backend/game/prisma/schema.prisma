// Game service database: the catalog of weapons / passive items / characters
// and every run a player finishes.
// Balance values (damage, cooldowns, ...) live in the game frontend (content.ts);
// the catalog only keeps the ids, names and max levels used to validate runs.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  IN_PROGRESS
  WON
  DIED
}

model Weapon {
  id       String @id // same id as the game frontend, e.g. "compiler"
  name     String
  maxLevel Int    @map("max_level")

  characters Character[]
  runWeapons RunWeapon[]

  @@map("weapons")
}

model PassiveItem {
  id       String @id // same id as the game frontend, e.g. "espresso"
  name     String
  maxLevel Int    @map("max_level")

  runPassiveItems RunPassiveItem[]

  @@map("passive_items")
}

model Character {
  id            String @id // same id as the game frontend, e.g. "ana-laura"
  name          String
  startWeaponId String @map("start_weapon_id")

  startWeapon Weapon @relation(fields: [startWeaponId], references: [id])
  runs        Run[]

  @@map("characters")
}

model Run {
  id           String    @id @default(uuid())
  userId       String    @map("user_id") // users live in the auth service: no foreign key
  characterId  String    @map("character_id")
  status       RunStatus @default(IN_PROGRESS)
  score        Int       @default(0)
  kills        Int       @default(0)
  levelReached Int       @default(1) @map("level_reached")
  survivedTime Int       @default(0) @map("survived_time") // seconds
  coinsEarned  Int       @default(0) @map("coins_earned")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  character    Character        @relation(fields: [characterId], references: [id])
  weapons      RunWeapon[]
  passiveItems RunPassiveItem[]

  @@index([userId])
  @@map("runs")
}

// weapons the player had when the run ended, with their final level
model RunWeapon {
  id       String @id @default(uuid())
  runId    String @map("run_id")
  weaponId String @map("weapon_id")
  level    Int

  run    Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  weapon Weapon @relation(fields: [weaponId], references: [id])

  @@unique([runId, weaponId])
  @@map("run_weapons")
}

// passive items the player had when the run ended, with their final level
model RunPassiveItem {
  id            String @id @default(uuid())
  runId         String @map("run_id")
  passiveItemId String @map("passive_item_id")
  level         Int

  run         Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  passiveItem PassiveItem @relation(fields: [passiveItemId], references: [id])

  @@unique([runId, passiveItemId])
  @@map("run_passive_items")
}
