generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PowerUp {
  id                String  @id @default(uuid())
  name              String
  price             Int
  attack            Int
  defense           Int
  health            Int
  movementSpeed     Float   @map("movement_speed")
  attackSpeed       Float   @map("attack_speed")
  projectileSpeed   Float   @map("projectile_speed")
  projectileSize    Float   @map("projectile_size")
  regeneration      Float   @default(0)
  imageUrl          String? @map("image_url")
  requiredPowerUpId String? @map("required_power_up_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  requiredPowerUp PowerUp?      @relation("PowerUpTiers", fields: [requiredPowerUpId], references: [id])
  unlocks         PowerUp[]     @relation("PowerUpTiers")
  owners          UserPowerUp[]

  @@map("power_ups")
}

model Character {
  id              String  @id @default(uuid())
  name            String
  title           String
  description     String
  color           String
  price           Int
  initialWeaponId String  @map("initial_weapon_id")
  hp              Int
  speed           Int
  damageMul       Float   @map("damage_mul")
  xpMul           Float   @map("xp_mul")
  pickupRadius    Int     @map("pickup_radius")
  imageUrl        String? @map("image_url")
  spriteUrl       String? @map("sprite_url")
  walkSpriteUrl   String? @map("walk_sprite_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owners UserCharacter[]

  @@map("characters")
}

model UserPowerUp {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  powerUpId String @map("power_up_id")

  createdAt DateTime @default(now()) @map("created_at")

  powerUp PowerUp @relation(fields: [powerUpId], references: [id])

  @@unique([userId, powerUpId])
  @@index([userId])
  @@map("user_power_ups")
}

model UserCharacter {
  id          String @id @default(uuid())
  userId      String @map("user_id")
  characterId String @map("character_id")

  createdAt DateTime @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id])

  @@unique([userId, characterId])
  @@index([userId])
  @@map("user_characters")
}

model Wallet {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  coins  Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}
