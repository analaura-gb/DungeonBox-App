{
  "name": "auth",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "bunx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "bunx eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "bunx eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "dev": "bun --env-file=.env.dev --watch src/main.ts",
    "start": "bun --env-file=.env.dev src/main.ts",
    "start:prod": "bun dist/src/main.js",
    "test": "bun --env-file=.env.test test ./src/",
    "test:e2e": "bun --env-file=.env.test test ./test/",
    "prisma:generate:dev": "bun --env-file=.env.dev prisma generate",
    "prisma:generate:test": "bun --env-file=.env.test prisma generate",
    "prisma:generate:prod": "bun  prisma generate",
    "prisma:studio": "bun --env-file=.env.dev prisma studio",
    "db:migrate:dev": "bun --env-file=.env.dev prisma migrate dev",
    "db:migrate:test": "bun --env-file=.env.test prisma migrate deploy",
    "db:migrate:prod": "bunx --bun prisma migrate deploy",
    "db:reset:dev": "bun --env-file=.env.dev prisma migrate reset",
    "db:reset:test": "bun --env-file=.env.test prisma migrate reset"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
