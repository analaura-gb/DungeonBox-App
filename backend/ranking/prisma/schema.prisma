generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RunStats {
  id             String   @id @default(uuid())
  runId          String   @unique @map("run_id")
  userId         String   @map("user_id")
  characterId    String   @map("character_id")
  won            Boolean
  score          Int
  enemiesKilled  Int      @map("enemies_killed")
  survivedTime   Int      @map("survived_time")
  coinsCollected Int      @map("coins_collected")
  weapons        Json     @default("[]")
  passiveItems   Json     @default("[]") @map("passive_items")
  createdAt      DateTime @default(now()) @map("created_at")

  generalStats GeneralStats @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([score])
  @@map("run_stats")
}

model GeneralStats {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  totalRuns           Int      @map("total_runs")
  totalWins           Int      @map("total_wins")
  totalScore          Int      @map("total_score")
  bestScore           Int      @map("best_score")
  totalEnemiesKilled  Int      @map("total_enemies_killed")
  totalSurvivedTime   Int      @map("total_survived_time")
  bestSurvivedTime    Int      @map("best_survived_time")
  totalCoinsCollected Int      @map("total_coins_collected")
  lastRunAt           DateTime @map("last_run_at")

  runs RunStats[]

  @@index([bestScore])
  @@map("general_stats")
}
